{
  "project": {"name": "Visite3D", "version": "1.0.0-alpha"},
  "paths": {"root": "./", "assets": "./assets", "generation": "./data/generation", "logs": "./data/generation/logs", "output_glb": "./data/generation/glb", "temp": "./data/generation/temp"},
