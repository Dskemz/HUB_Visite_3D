+
+<!-- ═══════════════════════════════════════════════════════════════
+     SPOT LUMINEUX TOURNANT — anime --sweep-a sur toutes les pilules
+     lumineuses (.lum-pill, .cine-enter-btn). Utilise requestAnimationFrame
+     pour être garanti dans tous les navigateurs (pas de dépendance @property).
+     Se met en pause quand l'onglet est caché (économie CPU / batterie).
+     ═══════════════════════════════════════════════════════════════ -->
+<script>
+(function(){
+  var PERIOD_LUM = 7000;   // ms pour un tour complet (RDV, boutons lumineux)
+  var PERIOD_CTA = 8000;   // ms pour "Commencer la visite"
+  var running = true, startTs = null;
+
+  function tick(ts){
+    if (!running) return;
+    if (startTs === null) startTs = ts;
+    var elapsed = ts - startTs;
+    var aLum = (elapsed % PERIOD_LUM) / PERIOD_LUM * 360;
+    var aCta = (elapsed % PERIOD_CTA) / PERIOD_CTA * 360;
+
+    /* On applique via CSS var pour eviter de recompiler la string du gradient
+       cote JS a chaque frame — c'est le navigateur qui l'interpole. */
+    var pills = document.querySelectorAll('.lum-pill, .rdv-pill');
+    for (var i = 0; i < pills.length; i++) pills[i].style.setProperty('--sweep-a', aLum.toFixed(1) + 'deg');
+
+    var ctas = document.querySelectorAll('.cine-enter-btn');
+    for (var j = 0; j < ctas.length; j++) ctas[j].style.setProperty('--sweep-a', aCta.toFixed(1) + 'deg');
+
+    requestAnimationFrame(tick);
+  }
+  requestAnimationFrame(tick);
+
+  /* Pause quand l'onglet est cache */
+  document.addEventListener('visibilitychange', function(){
+    if (document.hidden) { running = false; }
+    else { running = true; startTs = null; requestAnimationFrame(tick); }
+  });
+})();
+</script>
 </body>
